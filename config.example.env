# Copy to config.env (git ignores it) and fill in your own Apple developer values.

# Your Apple Developer team ID (10 characters).
TEAM_ID=ABCDE12345
# The app bundle ID. The camera extension gets this ID plus ".camera".
BUNDLE_ID=com.example.metaglasses
# The signing identity, exactly as `security find-identity -v -p codesigning` prints it.
SIGN_IDENTITY="Developer ID Application: Your Name (ABCDE12345)"

# Developer ID provisioning profiles for the two bundle IDs.
APP_PROFILE=profiles/app.provisionprofile
CAMERA_PROFILE=profiles/camera.provisionprofile

# App Store Connect API key, used to notarize and by scripts/asc.py.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
